{
  "name": "@motion-ppt/shared",
  "version": "0.1.0",
  "description": "Pure types, errors, math, units and type guards shared across Motion PPT packages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc -b --force && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "engines": { "node": ">=20.0.0" },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
